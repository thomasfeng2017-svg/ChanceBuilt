# Copy to .env for local development, or set these in your host's
# environment-variable settings for production.

# PostgreSQL connection string.
#   local:      postgresql://postgres:PASSWORD@localhost:5432/autoshop?schema=public
#   Neon:       postgresql://USER:PASSWORD@ep-xxx.us-west-2.aws.neon.tech/autoshop?sslmode=require
#   Railway:    provided automatically as DATABASE_URL when you add a Postgres service
#   Supabase:   use the "Connection pooling" string, not the direct one
DATABASE_URL="postgresql://postgres:password@localhost:5432/autoshop?schema=public"

# Safety switch for `npm run db:seed`, which DELETES the catalog before
# reseeding. The seed refuses to touch a non-localhost database unless this is
# set to 1. Only set it for a first-run production seed, then remove it.
# ALLOW_REMOTE_SEED=1

# --- Image uploads -----------------------------------------------------------
# REQUIRED IN PRODUCTION. Without these, admin uploads are written to
# public/uploads/, which does not survive a deploy on Vercel/Netlify (their
# filesystems are read-only and ephemeral) — photos would silently vanish.
# Locally you can leave them unset and uploads go to disk.
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# --- Payments (Stripe) -------------------------------------------------------
# Without these, checkout records an unpaid order and the page says so plainly.
# With them, checkout redirects to Stripe and the webhook marks orders paid.
# Use sk_test_/whsec_ keys until you are ready to take real money.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Absolute URL of the site, used for Stripe redirect targets.
# On Vercel this is inferred from VERCEL_URL, but set it for a custom domain.
# NEXT_PUBLIC_SITE_URL="https://chancebuiltperformance.com"

# --- Email (Resend) ----------------------------------------------------------
# Without these, emails are logged to the server console instead of sent, so the
# flow still works locally. EMAIL_FROM must be on a domain verified in Resend.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="ChanceBuilt Performance <orders@chancebuiltperformance.com>"
# Where order and booking alerts go. Defaults to the address in src/lib/site.ts.
# SHOP_NOTIFICATION_EMAIL="chance@chancebuiltperformance.com"
